+ function AssembleOutOfProcess
+        (     theProgramPath  : AnsiString;
+              theArguments  : RawByteString;
+          var theChildPID : cint;
+          var theAsmFile  : AnsiString): cint;
+      var
+        theErr  : cint;
+        thePid  : cint;
+        thePPArguments  : PPAnsiChar;
+        thePPChar : PPAnsiChar;
+    begin
+      theErr  := 0;
+      theChildPID := 0;
+      theAsmFile  := '';
+      UniqueString
+        ( theArguments);
+      thePPArguments  := StringToPPChar( theArguments, 1);
+      thePPArguments^ := @theProgramPath[ 1];
+      thePPChar := thePPArguments;
+      while thePPChar^ <> nil do
+      begin
+        theAsmFile  := thePPChar^;
+        thePPChar := PPAnsiChar( UInt64( thePPChar) + SizeOf( Pointer))
+      end;
+      thePID  := fpFork;
+      if thePID = 0
+        then begin
+          { we are in the child }
+          theErr  := FpExecV( theProgramPath, thePPArguments);
+          Halt
+            ( 127) { as FpExecV should not return }
+        end
+        else
+      if thePID = - 1
+        then theErr := fpGetErrno
+        else begin
+         { we are in the parent }
+          theChildPID := thePID;
+        end;
+      AssembleOutOfProcess  := theErr
+    end;
 
