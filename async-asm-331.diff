diff -ur a/rtl/darwin/unxfunc.inc b/rtl/darwin/unxfunc.inc
--- a/rtl/darwin/unxfunc.inc	2026-07-06 22:25:13
+++ b/rtl/darwin/unxfunc.inc	2026-07-21 15:21:03
@@ -26,6 +25,18 @@
 { closed our side, Now wait for the other - this appears to be needed ?? }
   pl:=@(filerec(f).userdata[2]);
   pclose := WaitProcess(pl^);
+end;
+
+Procedure PCloseNoWait(Var F:file; Var thePID: cint);
+var
+  pl : ^cint;
+  res: cint;
+begin
+  repeat
+    res:=fpclose(filerec(F).Handle);
+  until (res<>-1) or (fpgeterrno<>ESysEINTR);
+  pl:=@(filerec(f).userdata[2]);
+  thePID := pl^
 end;
 
 Function PClose(Var F:text) :cint;

