diff -ur a/compiler/globals.pas b/compiler/globals.pas
--- a/compiler/globals.pas	2026-07-06 22:25:13
+++ b/compiler/globals.pas	2026-07-24 08:55:32
@@ -769,7 +769,36 @@
   var
     AllowedFilenameTransFormations : tfilenametransformations = AllTransformations;
 
+{$ifdef async_assembly}
+  const
+    kAsyncAsmBufferSize = 8;
+  type
+    TAsyncAsmPath = AnsiString;
+    PAsyncAsmData = ^TAsyncAsmData;
+    TAsyncAsmData =
+      record { circular buffer }
+        cbNum : Int32;
+          { round buffer number of entries (between 0 and kAsyncAsmBufferSize) }
+        cbNextIndex : Int32;
+          { round buffer index of next PID entry}
+        cbEntries : array[ 1..kAsyncAsmBufferSize] of
+          record
+            ePid  : TPID;
+              { PID of the asynchronous external assembly process, e.g. clang }
+            eAsmFile  : TAsyncAsmPath;
+              { path of the assembly file, if it needs to be removed }
+          end
+      end;
 
+  var
+    gAsyncAsmData : TAsyncAsmData;
+
+  procedure InitAsyncAssembly;
+  procedure DoneAsyncAssembly;
+  procedure RegisterAsyncAssembly( theChildPID: pid_t; theAsmFileToRemove: AnsiString);
+  procedure WaitForAsyncAssembly; { to be called before linking starts }
+{$endif}
+
 implementation
 
 {$if defined(macos)}
@@ -1712,6 +1741,9 @@
    procedure DoneGlobals;
      begin
        calldoneprocs;
+     {$ifdef async_assembly}
+       DoneAsyncAssembly;
+     {$endif}
        librarysearchpath.Free;
        librarysearchpath := nil;
        unitsearchpath.Free;
@@ -1820,8 +1852,99 @@
         { enable all features by default }
         features:=[low(Tfeature)..high(Tfeature)];
 
+      {$ifdef async_assembly}
+        InitAsyncAssembly;
+      {$endif}
+
         callinitprocs;
      end;
+
+{$ifdef async_assembly}
+procedure InitAsyncAssembly;
+begin
+  with gAsyncAsmData do
+  begin
+    cbNum := 0;
+    cbNextIndex := 1;
+    FillChar
+      ( cbEntries, SizeOf( cbEntries), 0)
+  end
+end;
+{$endif}
+
+{$ifdef async_assembly}
+procedure DoneAsyncAssembly;
+begin
+end;
+{$endif}
+
+{$ifdef async_assembly}
+ function waitpid
+        (     thePid  : pid_t;
+          var theStatLoc  : cint;
+              theOptions  : cint): pid_t; cdecl; external;
+
+ function unlink
+        (     thePath : PChar): cint; cdecl; external;
+
+procedure WaitForAsyncAssemblyEntry
+        (       theIndex  : Int32);
+var
+  theResult : pid_t;
+  theStat : cint;
+begin
+  with gAsyncAsmData.cbEntries[ theIndex] do
+  begin
+    if ePid <> 0
+      then begin
+        theResult := waitpid( ePid, theStat, 0);
+        ePid := 0
+      end;
+    if Length( eAsmFile) > 0
+      then begin
+        theResult := unlink
+          ( @eAsmFile)
+      end
+  end
+end;
+
+procedure WaitForAsyncAssembly;
+var
+  theIndex  : Int32;
+begin
+  with gAsyncAsmData do
+  begin
+    for theIndex  := 1 to cbNum do
+      WaitForAsyncAssemblyEntry
+        ( theIndex);
+    cbNum := 0;
+    cbNextIndex := 1
+  end
+end;
+{$endif}
+
+{$ifdef async_assembly}
+procedure RegisterAsyncAssembly
+        (     theChildPID : pid_t;
+              theAsmFileToRemove  : AnsiString);
+    begin
+      with gAsyncAsmData do
+      begin
+        if cbNum = kAsyncAsmBufferSize
+          then WaitForAsyncAssemblyEntry
+             ( cbNextIndex)
+          else cbNum  := cbNum + 1;
+        with cbEntries[ cbNextIndex] do
+        begin
+          ePid  := theChildPid;
+          eAsmFile  := theAsmFileToRemove
+        end;
+        if cbNextIndex = kAsyncAsmBufferSize
+          then cbNextIndex  := 1
+          else cbNextIndex  := cbNextIndex + 1
+      end
+    end;
+{$endif}
 
 initialization
 {$ifdef LLVM}

